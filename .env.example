# ==============================================================================
# OpenMNC LLP — Complete Production Environment Template (.env)
# ==============================================================================

# 1. PRIMARY DATABASE (MongoDB Atlas Free Tier - M0 512MB)
# Obtain from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://amit_openmnc:YourPassword123@openmnc-cluster.mongodb.net/openmnc?retryWrites=true&w=majority

# 2. ALTERNATIVE DATABASE OPTION (TiDB Serverless - 5GB Free Forever)
# If purely text data ever expands beyond 512MB, swap in TiDB:
# TIDB_DATABASE_URL=mysql+aiomysql://root:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/openmnc?ssl_verify_cert=true

# 3. ADMIN AUTHENTICATION (JWT & Passlib Bcrypt)
JWT_SECRET=openmnc_jwt_super_secure_secret_key_change_in_production_2025
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72
ADMIN_EMAIL=amit@openmnc.com
# Generated via seed.py or passlib bcrypt:
ADMIN_PASSWORD_HASH=$2b$12$e8V9.1V9K47rC9QW79jVdeQZlG1Q0z4X06J5K98a0Q8B8h9k0h8zK

# 4. VERCEL / NETLIFY REBUILD WEBHOOKS (Crucial for Programmatic SEO)
# Triggers instant site rebuild & pre-rendering when CMS publishes blogs, services, or jobs
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxxxxxx/yyyyyyy
# Or if using Netlify:
# NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/6735e0000000000000000000

# 5. CLOUDINARY ZERO-STORAGE MEDIA CDN (Blog Covers, Service Icons)
# Obtain from https://cloudinary.com/console (Free tier: 25GB storage / 25GB monthly bandwidth)
# Absolutely NO binary image data or base64 is stored in the database!
CLOUDINARY_CLOUD_NAME=openmnc-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz_1234

# 6. GOOGLE WORKSPACE HR SYNC & CANDIDATE OAUTH
# Candidate "Sign in with Google" OAuth Client ID (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com

# Google Sheets HR Auto-Sync (Option A: Instant 1-click Google Apps Script Webhook)
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbz_XXXXXXXXXXXX/exec

# Google Sheets HR Auto-Sync (Option B: Google Cloud Service Account JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"openmnc-hr",...}
# GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# 7. SERVER PORT
PORT=8000
